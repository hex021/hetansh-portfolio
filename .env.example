# Firebase Configuration (Optional)
# If provided, the portfolio automatically synchronizes all project, research, and milestone updates to Google Cloud Firestore.
# If omitted, the portfolio runs seamlessly in Local Persistent Fallback Mode (100% functional out of the box).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
